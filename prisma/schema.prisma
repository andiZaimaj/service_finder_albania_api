// Service Finder Albania — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  WORKER
  ADMIN
}

enum WorkerType {
  SOLE_TRADER
  COMPANY
}

enum SubscriptionTier {
  NONE
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum JobStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workerProfile WorkerProfile?

  clientJobPosts JobPost[] @relation("ClientJobs")

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  notifications Notification[]

  reviewsAsClient Review[] @relation("ReviewClient")

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkerProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  type                 WorkerType
  businessName         String?
  bio                  String?
  nationalIdUrl        String?
  isIdVerified         Boolean            @default(false)
  subscriptionTier     SubscriptionTier   @default(NONE)
  subscriptionStatus   SubscriptionStatus @default(INACTIVE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  averageRating        Float              @default(0)
  totalReviews         Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cities           WorkerCity[]
  categories       WorkerCategory[]
  proposals        JobProposal[]
  reviews          Review[]
}

model WorkerCity {
  id               String @id @default(uuid())
  workerProfileId  String
  city             String

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, city])
  @@index([city])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  iconUrl   String?
  createdAt DateTime @default(now())

  workerCategories WorkerCategory[]
  jobPosts         JobPost[]
}

model WorkerCategory {
  id              String @id @default(uuid())
  workerProfileId String
  categoryId      String

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, categoryId])
}

model JobPost {
  id          String    @id @default(uuid())
  clientId    String
  title       String
  description String
  categoryId  String
  city        String
  address     String?
  status      JobStatus @default(OPEN)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client   User     @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  proposals JobProposal[]
  messages  Message[]
  reviews   Review[]

  @@index([clientId])
  @@index([status, city])
  @@index([categoryId])
}

model JobProposal {
  id              String         @id @default(uuid())
  jobPostId       String
  workerProfileId String
  message         String
  priceEstimate   Decimal        @db.Decimal(12, 2)
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  jobPost       JobPost       @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, workerProfileId])
  @@index([workerProfileId])
}

model Review {
  id              String   @id @default(uuid())
  clientId        String
  workerProfileId String
  jobPostId       String
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  client        User          @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  jobPost       JobPost       @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([clientId, workerProfileId, jobPostId])
  @@index([workerProfileId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  jobPostId  String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  jobPost  JobPost? @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId])
  @@index([jobPostId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
